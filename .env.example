# Copy this file to .env.local for local development.
# .env.local is ignored by Git and can contain real credentials.

# Database
# Listingify now uses PostgreSQL for the web API and operational scripts.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://listingify:listingify@localhost:5432/listingify
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000

# Web security
# Use a comma-separated allowlist for the Vite dev origins or production web origin.
LISTINGIFY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public HTTPS origin used behind reverse proxies to set durable session cookies.
LISTINGIFY_PUBLIC_ORIGIN=
# Only set true when the reverse proxy overwrites forwarded headers (the deploy template does).
LISTINGIFY_TRUSTED_PROXY=false
# Required to auto-seed the first admin on startup. Prefer scripts/create_admin_user.mjs for local setup.
LISTINGIFY_ADMIN_USERNAME=admin
LISTINGIFY_ADMIN_PASSWORD=
LISTINGIFY_ADMIN_DISPLAY_NAME=系统管理员
# Used to encrypt stored platform secrets such as SHEIN secretKey. Keep stable once credentials are saved.
LISTINGIFY_CREDENTIAL_SECRET=
LISTINGIFY_LOGIN_MAX_FAILURES=5
LISTINGIFY_LOGIN_LOCK_MINUTES=15
# Upload limits in MB. A full SHEIN ZIP image package can contain hundreds of images.
LISTINGIFY_MAX_IMAGE_UPLOAD_MB=20
LISTINGIFY_MAX_SPREADSHEET_UPLOAD_MB=50
LISTINGIFY_MAX_IMAGE_PACKAGE_MB=600
# Exact comma-separated hosts allowed for server-side remote square-image downloads.
LISTINGIFY_REMOTE_IMAGE_ALLOWED_HOSTS=product.resources.deepdraw.biz

# Product archive sync queue
PRODUCT_ARCHIVE_SYNC_INTERVAL_MS=1500
# Batch AI fill runs independently per login user, and each user can process
# multiple style codes in parallel. Idle slots are borrowed dynamically, so one
# busy user can fill up to LISTINGIFY_PRODUCT_ARCHIVE_AI_FILL_USER_MAX_CONCURRENCY
# when no other user is active. Actual total throughput is still bounded by
# LISTINGIFY_BACKGROUND_MAX_ACTIVE; set that to cover expected concurrent users
# times the normal per-user planning target. One user is capped at 10.
LISTINGIFY_BACKGROUND_MAX_ACTIVE=4
LISTINGIFY_PRODUCT_ARCHIVE_AI_FILL_USER_CONCURRENCY=2
LISTINGIFY_PRODUCT_ARCHIVE_AI_FILL_USER_MAX_CONCURRENCY=10
# AI fill OCR keeps hangtag/wash-label/flat-image evidence, but can recognize
# a small number of files in parallel and reuse identical in-flight results.
LISTINGIFY_HANGTAG_OCR_FILE_CONCURRENCY=2
LISTINGIFY_HANGTAG_OCR_CACHE_TTL_MS=600000

# MDM production OpenAPI
MDM_BASE_URL=https://mdm.semirapp.com
MDM_APP_ID=
MDM_APP_KEY=

# DeepDraw OpenAPI
DEEPDRAW_BASE_URL=http://open.deepdraw.cn
DEEPDRAW_TENANT_NAME=电商巴拉巴拉
DEEPDRAW_APP_KEY=
DEEPDRAW_APP_SECRET=
DEEPDRAW_DOP_KEY=
DEEPDRAW_MERCHANT_ID=
# Optional JSON object keyed by DeepDraw tenant name.
DEEPDRAW_TENANT_CREDENTIALS_JSON=
DEEPDRAW_TIMEOUT_MS=30000

# Optional fallback: read DeepDraw credentials from a local document.
# DEEPDRAW_CREDENTIAL_DOC=docs/reference/integration-handoffs/private/MDM&深绘 (1).docx

# SHEIN OpenAPI
SHEIN_BASE_URL=https://openapi.sheincorp.cn
SHEIN_LANGUAGE=zh-cn
SHEIN_OPEN_KEY_ID=
SHEIN_SECRET_KEY=

# Legacy AI production path. This remains the business-output source while
# unified routing is disabled or a scenario runs in shadow mode.
AI_BASE_URL=https://api.1xm.ai/v1
AI_MODEL=gemini-3-flash-preview
AI_API_KEY=
AI_TIMEOUT_MS=120000

# Unified scenario routing. Keep disabled until migration 043 is applied.
# Enabling this switch alone does not enable guarded writes: the scenario
# defaults below remain shadow/disabled.
AI_ROUTING_ENABLED=false
AI_ROUTING_CACHE_TTL_MS=600000
AI_ROUTING_CIRCUIT_FAILURE_THRESHOLD=3
AI_ROUTING_CIRCUIT_COOLDOWN_MS=60000
AI_ROUTING_MISCONFIGURED_COOLDOWN_MS=300000

# Provider-scoped endpoints and secrets. Even when gateways currently share a
# key, keep each secret variable separate so it can be rotated independently.
AI_PROVIDER_SEMIR_OVERSEAS_OPENAI_BASE_URL=https://ai-aigw.semir.com/overseas-openai-vip/v1
AI_PROVIDER_SEMIR_OVERSEAS_OPENAI_GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER_SEMIR_OVERSEAS_OPENAI_API_KEY=
AI_PROVIDER_SEMIR_OVERSEAS_ANTHROPIC_BASE_URL=https://ai-aigw.semir.com/overseas-anthropic-vip
AI_PROVIDER_SEMIR_OVERSEAS_ANTHROPIC_API_KEY=
AI_PROVIDER_SEMIR_DOMESTIC_OPENAI_BASE_URL=https://ai-aigw.semir.com/bailian-codingplan/v1
AI_PROVIDER_SEMIR_DOMESTIC_OPENAI_API_KEY=
AI_PROVIDER_1XM_BASE_URL=https://api.1xm.ai/v1
AI_PROVIDER_1XM_GEMINI_MODEL=gemini-3-flash-preview
AI_PROVIDER_1XM_API_KEY=
AI_GEMINI_INLINE_REMOTE_IMAGES=true
AI_GEMINI_INLINE_IMAGE_MAX_BYTES=4194304
AI_GEMINI_INLINE_IMAGE_LIMIT=8

# Scenario admission modes. DeepDraw field fill, OCR quality gate, and OCR
# vision are admitted by default once AI_ROUTING_ENABLED is true. SHEIN category is capped at shadow.
# Neutral SKC vision and DeepDraw trade are hard-disabled by code even if set
# to guarded.
AI_SCENARIO_TITLE_TRANSLATION_MODE=shadow
AI_SCENARIO_SIZE_MAPPING_MODE=shadow
AI_SCENARIO_SHEIN_ATTRIBUTE_MODE=shadow
AI_SCENARIO_SHEIN_DESCRIPTION_MODE=shadow
AI_SCENARIO_DEEPDRAW_FIELD_FILL_MODE=guarded
AI_SCENARIO_PRODUCT_ARCHIVE_OCR_QUALITY_MODE=guarded
AI_SCENARIO_PRODUCT_ARCHIVE_OCR_VISION_MODE=guarded
AI_SCENARIO_SHEIN_CATEGORY_MODE=shadow
AI_SCENARIO_NEUTRAL_SKC_MODE=disabled
AI_SCENARIO_DEEPDRAW_TRADE_MODE=disabled

# Hangtag/wash-label OCR first lets AI judge whether ordinary OCR fields are
# reliable, then falls back to multimodal AI when ordinary OCR fails, returns
# garbled text, extracts no structured fields, or the quality gate rejects the
# extracted fields. Images are sent as base64 data URLs, never as local paths.
LISTINGIFY_HANGTAG_OCR_AI_QUALITY_GATE=true
LISTINGIFY_HANGTAG_OCR_QUALITY_TEXT_LIMIT=5000
LISTINGIFY_HANGTAG_OCR_VISION_FALLBACK=true
LISTINGIFY_HANGTAG_OCR_VISION_IMAGE_MAX_BYTES=4194304
LISTINGIFY_HANGTAG_OCR_VISION_IMAGE_WIDTH=2200
LISTINGIFY_HANGTAG_OCR_VISION_MAX_IMAGES=4

# 1xm guarded fallback is closed unless a valid positive request budget is
# supplied. Set an optional positive token cap as a second cost guard; zero is
# the safe default for both values.
AI_1XM_DAILY_REQUEST_BUDGET=0
AI_1XM_DAILY_TOKEN_BUDGET=0
